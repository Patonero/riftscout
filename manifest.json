{
  "manifest_version": 3,
  "name": "RiftScout",
  "version": "0.4.0",
  "description": "Scouts eloshowdown.com ELO ratings inline on Riftbound event roster pages.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.cloudflare.riftbound.uvsgames.com/*",
    "https://eloshowdown.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://locator.riftbound.uvsgames.com/events/*",
        "https://playriftbound.com/*/events/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
